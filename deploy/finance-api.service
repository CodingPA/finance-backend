[Unit]
Description=finance-backend API (Uvicorn/ASGI)
After=network.target

# Replace `deployer` and /home/deployer/finance-backend below with the
# user and path you actually deployed to (docs/deployment.md).
[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/home/deployer/finance-backend
EnvironmentFile=/home/deployer/finance-backend/.env
ExecStart=/home/deployer/finance-backend/.venv/bin/uvicorn core.asgi:application --host 127.0.0.1 --port 8001 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
