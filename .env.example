# Copy this to .env and fill in real values. .env itself is gitignored.
#
# NOT INVESTMENT ADVICE -- research and education only. The paper trading
# league is a simulation: it places no real orders and holds no real money.
# The API tokens below are read-only market-data credentials; nothing in this
# project can place a trade with a broker. Note that the LLM keys and Celery
# beat both cost real money to run -- see "Costs" in README.md.

# --- companies app (SEC EDGAR / FMP screening) ---
FMP_API_KEY=
# Required. SEC rejects every request without a contact email in the
# User-Agent header (403). Your real email, not a placeholder. Also reused
# (optionally) in the Wikipedia client's User-Agent (wikipedia_client.py) --
# Wikipedia doesn't hard-require it the way SEC does, so wiki linking still
# works if this is unset, just with a less identifiable User-Agent.
SEC_CONTACT_EMAIL=

# --- SteadyAPI (live options chain: price, greeks, IV) ---
# Personal access token from the SteadyAPI dashboard. Without this,
# get_options_chain (assistant/tools.py) tells the user live options data
# isn't configured rather than erroring.
STEADY_API_TOKEN=

# --- Tradier (quotes + option chains, companies/services/tradier.py) ---
# Being evaluated as a fresher alternative to SteadyAPI, whose options
# quotes only refresh ~every 10 min -- see `python manage.py
# tradier_itm_quote TICKER`. Get a token at https://web.tradier.com/user/api:
#   - Production token: needs a funded/linked Tradier brokerage account
#     (or their paid market-data add-on). Real-time data. Use this for
#     the freshness check to mean anything.
#   - Sandbox token: works standalone, no brokerage account, but serves
#     DELAYED data -- same staleness problem as SteadyAPI, so it does not
#     answer the "is this actually real-time" question, only exercises
#     the API shape.
#
# A PRODUCTION token here is tied to YOUR brokerage account -- Tradier's
# terms restrict redistributing the market data it returns. If this app is
# ever reachable by anyone other than you (an open server, an unlocked
# sign-up allowlist -- see accounts.AllowedEmail / README.md's "Crucial
# Security & ToS Compliance Notice"), every quote/chain another person
# views is data redistribution under your account, and their traffic
# burns your rate limit. Single-tenant/personal use only. Never commit a
# real value here -- this file is the example, .env is gitignored.
TRADIER_API_TOKEN=
# https://api.tradier.com (production, real-time) or
# https://sandbox.tradier.com (sandbox, delayed). Must match the token
# type above -- a production token against the sandbox host (or vice
# versa) 401s.
TRADIER_BASE_URL=https://api.tradier.com

# --- Polygon.io (persisted daily OHLCV history, companies/services/polygon.py) ---
# Get a free key at https://polygon.io/ (rebranded "Massive" in 2026, same
# API host). The free "Stocks Basic" tier (5 req/min, end-of-day data, 2
# years of history) is enough -- this module only makes one full-market
# call per session, not one call per ticker. Without this, the
# ingest_daily_bars Celery task no-ops rather than erroring.
POLYGON_API_KEY=

# --- Brave Search (generic open-web search, companies/services/brave_search.py) ---
# Get a key at https://api-dashboard.search.brave.com/. Powers the
# search_web tool in both the assistant chat and the paper trading
# league's AI competitors. Without this, search_web tells the model
# search isn't configured rather than erroring -- everything else in this
# app keeps working.
BRAVE_API_KEY=

# Which provider live quotes/options chains come from -- "steady" or
# "tradier" -- for everything that prices a trade or a mark-to-market
# (companies/services/pricing.py). Only set the API token(s) for whichever
# one you pick above; you don't need both. "tradier" is also
# core/settings.py's own code-level default (if this line is deleted
# rather than left as-is) -- kept in sync deliberately, so a fresh .env
# behaves the same whether this line is here or missing.
PRICING_PROVIDER=tradier

# --- Django ---
# Leave unset for local dev (settings.py falls back to a dev-only key).
# Always set a real one outside local dev.
SECRET_KEY=
DEBUG=true
# Must also list the *frontend's* host, not just the API's: Channels wraps
# the WebSocket router in AllowedHostsOriginValidator, which checks the
# browser-sent Origin header against this list. Leave the frontend host out
# and HTTP looks perfectly healthy while every WS handshake is rejected.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use SQLite locally. Set to switch to Postgres, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated origins the frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origins allowed to POST the admin login form. Unset is correct for local
# dev (Django trusts same-origin http); set to https://<api-host> once the
# app is served over https behind a proxy, or admin login 403s.
CSRF_TRUSTED_ORIGINS=

# Set to true ONLY when the app sits behind a reverse proxy that overwrites
# X-Forwarded-Proto and is not reachable directly. See docs/deployment.md.
TRUST_PROXY_SSL_HEADER=false

# OAuth client ID from Google Cloud Console -- required for /api/auth/google/
# to work. Must match the client ID the frontend uses to request ID tokens.
GOOGLE_OAUTH_CLIENT_ID=

# --- Celery / Redis (background jobs: batch screening, later AI processing) ---
# From your Redis Cloud database's "Connect" tab. For a local redis-server
# instead (how the deployed box runs it): REDIS_HOST=127.0.0.1, no
# username/password, REDIS_USE_TLS=false. Pick a REDIS_DB index no other
# project on the same box uses -- two Celery apps sharing one broker DB will
# consume each other's tasks and drop them as unknown.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=10
REDIS_USE_TLS=true

# --- Weaviate / OpenAI (semantic search infra over ResearchClip text) ---
# Shared Weaviate server across other apps -- no vectorizer module enabled,
# vectors are computed here (OPENAI_API_KEY) and sent precomputed.
WEAVIATE_URL=
WEAVIATE_GRPC_HOST=
WEAVIATE_API_KEY=
# Namespaces the collection name (FinanceApp_{env}_ResearchClip). This app
# doesn't have a prod Weaviate instance yet.
WEAVIATE_ENVIRONMENT=Dev
# Without this, clip indexing silently no-ops -- everything else still works.
OPENAI_API_KEY=

# --- League (paper trading competition, league app) ---
# Off by default. league-forced-checkins alone ticks every 5 minutes and
# dispatches a real, billed LLM call whenever a competitor's check-in is
# due -- turning this on with Celery beat running means real, recurring
# API spend starts the moment a Competition exists, not just when you
# expect it to. Turn on only once you actually want a competition
# running; the Anthropic/OpenAI/Gemini keys below power it once you do.
ENABLE_LEAGUE=false

# --- Anthropic (chat assistant, assistant app) ---
ANTHROPIC_API_KEY=

# --- Gemini (league's AI competitors can run on Gemini too, in addition to
# Anthropic/OpenAI above -- AssistantModel.provider, league/services/
# llm_gemini.py). Not used by the assistant app's own chat loop, which is
# Anthropic-only. ---
GEMINI_API_KEY=

# --- Media ingestion (media app: mp3/mp4 upload, diarized transcription) ---
# Off by default -- a niche feature on this platform, and the only one
# that needs a real system binary (ffmpeg/ffprobe) outside the Python
# dependency tree. When false, the media app isn't installed at all: no
# migrations, no /api/media/ routes, no search_media_transcripts tool,
# and a Docker image doesn't need ffmpeg installed either. Set true to
# turn it on -- everything else in this section only matters once you do.
ENABLE_MEDIA=false

# S3 storage for uploaded files. Leave AWS_STORAGE_BUCKET_NAME unset to fall
# back to local disk storage (settings.py's STORAGES config) -- fine for
# quick checks, but the real bucket is needed for anything durable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# ffmpeg/ffprobe resolution (media/services/ffmpeg.py): PATH is checked
# first regardless of OS (the real server install), then a project-root
# ffmpeg.exe/ffprobe.exe fallback (Windows dev convenience). Only set these
# to force a specific binary.
FFMPEG_PATH=
FFPROBE_PATH=
# How many 60s audio chunks get diarized concurrently once the first
# minute's reference speaker samples are extracted.
ASSISTANT_MEDIA_CHUNK_CONCURRENCY=4
